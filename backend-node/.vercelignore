# Vercel ignore file - exclude unnecessary files from deployment

# Environment files
.env
.env.local
.env.*.local

# Development files
nodemon.json

# Uploads directory (should use cloud storage on Vercel)
uploads/**
!uploads/.gitkeep

# Documentation
README.md
VERCEL_DEPLOYMENT.md

# Database files
*.sql

# Git
.git
.gitignore

# IDE
.vscode
.idea
*.swp
*.swo

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage
.nyc_output
